{
  "name": "ScaleX AI | Campaign performance",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "scalex-demo/campaign-performance",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "campaign-performance-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "webhookId": "scalex-campaign-performance"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d = $input.first().json.body ?? $input.first().json;\nconst spend=Number(d.spend||0),clicks=Number(d.clicks||0),leads=Number(d.leads||0);const output = {cpc:clicks>0?spend/clicks:null,cpl:leads>0?spend/leads:null,clickToLeadRate:clicks>0?leads/clicks:null};\nreturn [{json:output}];\n"
      },
      "id": "campaign-performance-code",
      "name": "Transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "campaign-performance-response",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
