{
  "name": "ScaleX AI | Daily KPI snapshot",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "scalex-demo/daily-kpi-snapshot",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "daily-kpi-snapshot-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "webhookId": "scalex-daily-kpi-snapshot"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d = $input.first().json.body ?? $input.first().json;\nconst revenue=Number(d.revenue||0),orders=Number(d.orders||0),spend=Number(d.ad_spend||0);const output = {revenue,orders,aov:orders>0?revenue/orders:null,roas:spend>0?revenue/spend:null};\nreturn [{json:output}];\n"
      },
      "id": "daily-kpi-snapshot-code",
      "name": "Transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "daily-kpi-snapshot-response",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Transform",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transform": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "tags": []
}
