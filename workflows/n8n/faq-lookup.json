{
  "name": "ScaleX AI | FAQ lookup",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "scalex-demo/faq-lookup",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "faq-lookup-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "webhookId": "scalex-faq-lookup"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d = $input.first().json.body ?? $input.first().json;\nconst q=String(d.question||'').toLowerCase();const faqs=d.faqs&&typeof d.faqs==='object'?d.faqs:{};const output = {answer:faqs[q]||null,matched:Object.prototype.hasOwnProperty.call(faqs,q)};\nreturn [{json:output}];\n"
      },
      "id": "faq-lookup-code",
      "name": "Transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "faq-lookup-response",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Transform",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transform": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "tags": []
}
